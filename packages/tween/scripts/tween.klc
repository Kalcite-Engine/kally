// Optional Kally package: tween
// Import with: use tween;
public i16 tween_step(i16 value, i16 target, i16 step) {
    if (step < 0) {
        return value;
    }
    if (value < target) {
        i16 next = value + step;
        if (next > target) {
            return target;
        }
        return next;
    }
    if (value > target) {
        i16 next = value - step;
        if (next < target) {
            return target;
        }
        return next;
    }
    return value;
}
